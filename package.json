{
  "type": "module",
  "name": "PracticeStarter",
  "version": "0.0.0",
  "private": true,
  "description": "11ty-based local development environment for static website projects",
  "license": "MIT",
  "author": "Codrin Pavel (https://codrinpavel.com)",
  "contributors": [
    "Codrin Pavel <hello@codrinpavel.com>"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "start:11ty": "eleventy --serve",
    "start:js": "rollup -c -w",
    "start:css": "sass --load-path=node_modules --load-path=src/assets/sass --watch --no-charset --embed-source-map src/assets/sass:dist/assets/min",
    "build:11ty": "eleventy",
    "build:js": "rollup -c",
    "build:css": "sass --load-path=node_modules --load-path=src/assets/sass --style=compressed --no-source-map --no-charset src/assets/sass:dist/assets/min",
    "clean": "rimraf dist",
    "clean:min": "rimraf dist/assets/min",
    "start": "cross-env ELEVENTY_ENV=dev npm-run-all clean -p start:css start:js start:11ty",
    "build": "cross-env ELEVENTY_ENV=production npm-run-all clean build:css build:js build:11ty clean:min",
    "debug": "cross-env DEBUG=Eleventy:Benchmark* npm run start",
    "import": "node scripts/import-modules.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "cross-env": "^10.1.0",
    "eleventy-plugin-svg-contents": "^0.7.0",
    "html-minifier": "^4.0.0",
    "npm-run-all": "^4.1.5",
    "patch-package": "8.0.1",
    "purgecss": "^8.0.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.4",
    "sass": "^1.102.0"
  },
  "dependencies": {
    "@splidejs/splide": "^4.1.4",
    "lenis": "^1.3.26",
    "lucide-static": "^1.49.0"
  }
}
